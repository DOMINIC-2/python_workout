    "## 3. Moving average"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "def moving_average(xs, window):\n",
    "    \"\"\"Rolling mean over full windows only.\n",
    "\n",
    "    >>> moving_average([1, 2, 3, 4, 5], 3)\n",
    "    [2.0, 3.0, 4.0]\n",
    "\n",
    "    Raise ValueError if window < 1. Return [] if window > len(xs).\n",
    "    \"\"\"\n",
    "    raise NotImplementedError"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "def check_3():\n",
    "    assert moving_average([1, 2, 3, 4, 5], 3) == [2.0, 3.0, 4.0]\n",
    "    assert moving_average([1, 2], 3) == []\n",
    "    assert moving_average([4, 6], 1) == [4.0, 6.0]\n",
    "    with raises(ValueError):\n",
    "        moving_average([1, 2, 3], 0)\n",
    "    print(\"Exercise 3 passed\")\n",
    "check_3()"
   ]
