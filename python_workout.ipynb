    "def daily_peak(df):\n",
    "    \"\"\"Given a DataFrame with a datetime column 'timestamp' and numeric 'load',\n",
    "    return a DataFrame with one row per calendar day:\n",
    "    columns ['date', 'peak_load', 'peak_hour'] where peak_hour is the hour (0-23)\n",
    "    at which that day's maximum load occurred. Sorted by date, default index.\n",
    "\n",
    "    Hint: df.assign(...), groupby, idxmax.\n",
    "    \"\"\"\n",
    "    raise NotImplementedError"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "def check_9():\n",
    "    df = pd.DataFrame({\n",
    "        \"timestamp\": pd.to_datetime([\"2026-01-02 08:00\", \"2026-01-02 19:00\", \"2026-01-02 23:00\",\n",
    "                                     \"2026-01-01 07:00\", \"2026-01-01 20:00\"]),\n",
    "        \"load\": [1500, 2100, 1800, 1400, 2300],\n",
    "    })\n",
    "    out = daily_peak(df)\n",
    "    assert list(out.columns) == [\"date\", \"peak_load\", \"peak_hour\"]\n",
    "    assert out[\"peak_load\"].tolist() == [2300, 2100]\n",
    "    assert out[\"peak_hour\"].tolist() == [20, 19]\n",
    "    assert list(out.index) == [0, 1]\n",
    "    print(\"Exercise 9 passed\")\n",
    "check_9()"
   ]
