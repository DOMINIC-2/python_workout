    "## 5. Grouping records"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "def group_by(records, key):\n",
    "    \"\"\"Group a list of dicts by the value of `key`.\n",
    "\n",
    "    >>> group_by([{\"m\": \"Jan\", \"v\": 1}, {\"m\": \"Feb\", \"v\": 2}, {\"m\": \"Jan\", \"v\": 3}], \"m\")\n",
    "    {'Jan': [{'m': 'Jan', 'v': 1}, {'m': 'Jan', 'v': 3}], 'Feb': [{'m': 'Feb', 'v': 2}]}\n",
    "\n",
    "    Keep first-seen key order and original record order within each group.\n",
    "    \"\"\"\n",
    "    raise NotImplementedError"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "def check_5():\n",
    "    recs = [{\"m\": \"Jan\", \"v\": 1}, {\"m\": \"Feb\", \"v\": 2}, {\"m\": \"Jan\", \"v\": 3}]\n",
    "    out = group_by(recs, \"m\")\n",
    "    assert list(out) == [\"Jan\", \"Feb\"]\n",
    "    assert out[\"Jan\"] == [{\"m\": \"Jan\", \"v\": 1}, {\"m\": \"Jan\", \"v\": 3}]\n",
    "    assert group_by([], \"m\") == {}\n",
    "    print(\"Exercise 5 passed\")\n",
    "check_5()"
   ]
