    "## 6. Windows for forecasting"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "def make_windows(series, window):\n",
    "    \"\"\"Build (X, y) pairs for one-step-ahead forecasting.\n",
    "\n",
    "    Each X row is `window` consecutive values; y is the value right after.\n",
    "\n",
    "    >>> make_windows([1, 2, 3, 4, 5], 3)\n",
    "    ([[1, 2, 3], [2, 3, 4]], [4, 5])\n",
    "\n",
    "    Raise ValueError if window < 1 or the series is too short to make one pair.\n",
    "    \"\"\"\n",
    "    raise NotImplementedError"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "def check_6():\n",
    "    assert make_windows([1, 2, 3, 4, 5], 3) == ([[1, 2, 3], [2, 3, 4]], [4, 5])\n",
    "    X, y = make_windows(list(range(10)), 4)\n",
    "    assert len(X) == len(y) == 6 and X[0] == [0, 1, 2, 3] and y[-1] == 9\n",
    "    with raises(ValueError):\n",
    "        make_windows([1, 2, 3], 3)\n",
    "    with raises(ValueError):\n",
    "        make_windows([1, 2, 3], 0)\n",
    "    print(\"Exercise 6 passed\")\n",
    "check_6()"
   ]
  },
