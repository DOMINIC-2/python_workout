    "## 7. A timing decorator"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "def timed(func):\n",
    "    \"\"\"Decorator: after each call, store the duration (seconds) on\n",
    "    `wrapper.last_duration` and return the function's result unchanged.\n",
    "\n",
    "    Use functools.wraps so the function's name and docstring survive.\n",
    "    \"\"\"\n",
    "    raise NotImplementedError"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "def check_7():\n",
    "    @timed\n",
    "    def add(a, b):\n",
    "        \"\"\"Add two numbers.\"\"\"\n",
    "        return a + b\n",
    "    assert add(2, 3) == 5\n",
    "    assert add.last_duration >= 0\n",
    "    assert add.__name__ == \"add\"\n",
    "    assert add.__doc__ == \"Add two numbers.\"\n",
    "    print(\"Exercise 7 passed\")\n",
    "check_7()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 8. A class: streaming mean and variance"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "class RunningStats:\n",
    "    \"\"\"Streaming mean and sample variance without storing the data (Welford).\n",
    "\n",
    "    >>> s = RunningStats()\n",
    "    >>> for x in [2, 4, 4, 4, 5, 5, 7, 9]:\n",
    "    ...     s.update(x)\n",
    "    >>> s.count, s.mean\n",
    "    (8, 5.0)\n",
    "\n",
    "    - `variance` is the *sample* variance (divide by n - 1); None if count < 2\n",
    "    - `std` is its square root; None if count < 2\n",
    "    \"\"\"\n",
    "\n",
    "    def __init__(self):\n",
    "        raise NotImplementedError\n",
    "\n",
    "    def update(self, x):\n",
    "        raise NotImplementedError\n",
    "\n",
    "    @property\n",
    "    def variance(self):\n",
    "        raise NotImplementedError\n",
    "\n",
    "    @property\n",
    "    def std(self):\n",
    "        raise NotImplementedError"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "def check_8():\n",
    "    s = RunningStats()\n",
    "    assert s.variance is None and s.std is None\n",
    "    s.update(3)\n",
    "    assert s.count == 1 and s.mean == 3 and s.variance is None\n",
    "    t = RunningStats()\n",
    "    for x in [2, 4, 4, 4, 5, 5, 7, 9]:\n",
    "        t.update(x)\n",
    "    assert t.count == 8 and t.mean == 5.0\n",
    "    assert t.variance == approx(32 / 7)\n",
    "    assert t.std == approx(math.sqrt(32 / 7))\n",
    "    print(\"Exercise 8 passed\")\n",
    "check_8()"
   ]
  },
