    "## 2. Counting words"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "def word_freq(text, top_n=3):\n",
    "    \"\"\"Return the `top_n` most common words as (word, count) tuples.\n",
    "\n",
    "    - Case-insensitive; ignore punctuation (keep letters, digits, apostrophes)\n",
    "    - Break ties alphabetically\n",
    "\n",
    "    >>> word_freq(\"The cat and the hat. The end!\", 2)\n",
    "    [('the', 3), ('and', 1)]\n",
    "    \"\"\"\n",
    "    raise NotImplementedError"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "def check_2():\n",
    "    assert word_freq(\"The cat and the hat. The end!\", 2) == [(\"the\", 3), (\"and\", 1)]\n",
    "    assert word_freq(\"Don't stop, don't STOP!\", 2) == [(\"don't\", 2), (\"stop\", 2)]\n",
    "    assert word_freq(\"\", 3) == []\n",
    "    print(\"Exercise 2 passed\")\n",
    "check_2()"
   ]
  },
